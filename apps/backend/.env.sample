YTDLE_PRIMARY.ENV="local"

YTDLE_SERVER.PORT="8080"
YTDLE_SERVER.READ_TIMEOUT="30"
YTDLE_SERVER.WRITE_TIMEOUT="30"
YTDLE_SERVER.IDLE_TIMEOUT="60"
YTDLE_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

YTDLE_DATABASE.HOST="localhost"
YTDLE_DATABASE.PORT="5432"
YTDLE_DATABASE.USER="postgres"
YTDLE_DATABASE.PASSWORD=""
YTDLE_DATABASE.NAME="YTDLE"
YTDLE_DATABASE.SSL_MODE="disable"
YTDLE_DATABASE.MAX_OPEN_CONNS="25"
YTDLE_DATABASE.MAX_IDLE_CONNS="25"
YTDLE_DATABASE.CONN_MAX_LIFETIME="300"
YTDLE_DATABASE.CONN_MAX_IDLE_TIME="300"

YTDLE_AUTH.SECRET_KEY="secret"

YTDLE_INTEGRATION.RESEND_API_KEY="resend_key"

YTDLE_REDIS.ADDRESS="redis://localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
YTDLE_OBSERVABILITY.SERVICE_NAME="YTDLE"
YTDLE_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
YTDLE_OBSERVABILITY.LOGGING.LEVEL="debug"
YTDLE_OBSERVABILITY.LOGGING.FORMAT="console"
YTDLE_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
YTDLE_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
YTDLE_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
YTDLE_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
YTDLE_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
YTDLE_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
YTDLE_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
YTDLE_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
YTDLE_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"
